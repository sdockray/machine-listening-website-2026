---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCoverImage } from '../../lib/content-images';

const works = (await getCollection('works'))
  .filter((entry) => !entry.data.hideFromIndex)
  .sort((a, b) => {
    const priorityDiff = (b.data.priority ?? 1) - (a.data.priority ?? 1);
    if (priorityDiff !== 0) return priorityDiff;

    const yearA = a.data.year ?? 0;
    const yearB = b.data.year ?? 0;
    if (yearB !== yearA) return yearB - yearA;

    return a.data.title.localeCompare(b.data.title);
  });

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\//, '')}`;

const firstWorkWithCover = works.find((w) => getCoverImage(w));
const indexShareImage = firstWorkWithCover ? getCoverImage(firstWorkWithCover) : undefined;
---
<BaseLayout title="Works" image={indexShareImage}>
  <h1>Works</h1>
  <ul class="collection-grid">
    {works.map((work) => {
      const listingImage = getCoverImage(work);
      const listingImageUrl = listingImage ? (listingImage.startsWith('http') || listingImage.startsWith('//') ? listingImage : withBase(listingImage)) : undefined;
      return (
        <li class="collection-card">
          <a href={`./${work.id}/`}>
            {listingImageUrl && (
              <img src={listingImageUrl} alt={work.data.title} loading="lazy" />
            )}
            <h2>{work.data.title}</h2>
            <p class="collection-meta">
              {work.data.type && work.data.type.length > 0 && <span style="text-transform: capitalize;">{work.data.type.join(', ')}</span>}
              {work.data.type && work.data.type.length > 0 && work.data.year && <span> &middot; </span>}
              {work.data.year && <span>{work.data.year}{work.data.endYear ? `–${work.data.endYear}` : ''}</span>}
            </p>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

