---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCoverImage } from '../../lib/content-images';

const softwareItems = (await getCollection('software'))
  .filter((entry) => !entry.data.hideFromIndex)
  .sort((a, b) => {
    const priorityDiff = (b.data.priority ?? 1) - (a.data.priority ?? 1);
    if (priorityDiff !== 0) return priorityDiff;

    return a.data.title.localeCompare(b.data.title);
  });

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\//, '')}`;

const firstSoftwareWithCover = softwareItems.find((item) => getCoverImage(item));
const indexShareImage = firstSoftwareWithCover ? getCoverImage(firstSoftwareWithCover) : undefined;
---
<BaseLayout title="Software" image={indexShareImage}>
  <h1>Software</h1>
  <ul class="collection-grid">
    {softwareItems.map((item) => {
      const listingImage = getCoverImage(item);
      const listingImageUrl = listingImage ? (listingImage.startsWith('http') || listingImage.startsWith('//') ? listingImage : withBase(listingImage)) : undefined;
      return (
        <li class="collection-card">
          <a href={`./${item.id}/`}>
            {listingImageUrl && (
              <img src={listingImageUrl} alt={item.data.title} loading="lazy" />
            )}
            <h2>{item.data.title}</h2>
            {item.data.description && <p class="collection-meta">{item.data.description}</p>}
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

