---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCoverImage } from '../../../lib/content-images';

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter((entry) => !entry.data.hideFromIndex);
  
  // Extract all unique categories
  const categories = [...new Set(allPosts.map(post => post.data.category).filter(Boolean))];
  
  return categories.map(category => {
    const categoryPosts = allPosts.filter(post => post.data.category === category);
    
    // Sort by date descending
    categoryPosts.sort((a, b) => {
      const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
      const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
      return dateB - dateA;
    });

    return {
      params: { category },
      props: { posts: categoryPosts, category },
    };
  });
}

const { posts, category } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\//, '')}`;

const firstPostWithCover = posts.find((p) => getCoverImage(p));
const categoryShareImage = firstPostWithCover ? getCoverImage(firstPostWithCover) : undefined;
---
<BaseLayout title={category} skin={category} image={categoryShareImage}>
  <p><a href={withBase('/blog/')}>Blog</a> / {category}</p>
  <h1>{category}</h1>
  
  <ul class="collection-grid">
    {posts.map((post) => {
      const cover = getCoverImage(post);
      const coverUrl = cover ? (cover.startsWith('http') || cover.startsWith('//') ? cover : withBase(cover)) : undefined;
      return (
        <li class="collection-card">
          <a href={withBase(`/blog/${category}/${post.id}/`)}>
            {coverUrl && (
              <img src={coverUrl} alt="" loading="lazy" />
            )}
            <h2>{post.data.title}</h2>
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

