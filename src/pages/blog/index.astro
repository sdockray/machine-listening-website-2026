---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCoverImage } from '../../lib/content-images';

const allPosts = (await getCollection('blog')).filter((entry) => !entry.data.hideFromIndex);

// Sort by date descending
allPosts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\//, '')}`;

const firstPostWithCover = allPosts.find((p) => getCoverImage(p));
const indexShareImage = firstPostWithCover ? getCoverImage(firstPostWithCover) : undefined;
---
<BaseLayout title="Blog" skin="default-blog" image={indexShareImage}>
  <h1>Blog</h1>
  
  <ul class="collection-grid">
    {allPosts.map((post) => {
      const categoryPath = post.data.category ? `${post.data.category}/` : '';
      const cover = getCoverImage(post);
      const coverUrl = cover ? (cover.startsWith('http') || cover.startsWith('//') ? cover : withBase(cover)) : undefined;
      return (
        <li class="collection-card">
          <a href={withBase(`/blog/${categoryPath}${post.id}/`)}>
            {coverUrl && (
              <img src={coverUrl} alt="" loading="lazy" />
            )}
            <h2>{post.data.title}</h2>
            {post.data.category && (
              <p class="collection-meta">Category: {post.data.category}</p>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

