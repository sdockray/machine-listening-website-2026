---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';
import { getCoverImage } from '../../lib/content-images';

const entry = await getEntry('texts', 'texts');
const title = entry?.data.title || 'Texts';
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const shareImage = entry ? getCoverImage(entry) : undefined;
---
<BaseLayout title={title} image={shareImage}>
  <h1>{title}</h1>
  {Content ? <Content /> : <p>No texts index content found.</p>}
</BaseLayout>

