---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCoverImage } from '../../lib/content-images';

const curationItems = (await getCollection('curation'))
  .filter((entry) => !entry.data.hideFromIndex)
  .sort((a, b) => {
    const priorityDiff = (b.data.priority ?? 1) - (a.data.priority ?? 1);
    if (priorityDiff !== 0) return priorityDiff;

    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    if (dateB !== dateA) return dateB - dateA;

    return a.data.title.localeCompare(b.data.title);
  });

const baseUrl = import.meta.env.BASE_URL;
const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
const withBase = (path: string) => `${normalizedBaseUrl}${path.replace(/^\//, '')}`;

const firstCurationWithCover = curationItems.find((item) => getCoverImage(item));
const indexShareImage = firstCurationWithCover ? getCoverImage(firstCurationWithCover) : undefined;
---
<BaseLayout title="Curation" image={indexShareImage}>
  <h1>Curation</h1>
  <ul class="collection-grid">
    {curationItems.map((item) => {
      const listingImage = getCoverImage(item);
      const listingImageUrl = listingImage ? (listingImage.startsWith('http') || listingImage.startsWith('//') ? listingImage : withBase(listingImage)) : undefined;
      return (
        <li class="collection-card">
          <a href={`./${item.id}/`}>
            {listingImageUrl && (
              <img src={listingImageUrl} alt={item.data.title} loading="lazy" />
            )}
            <h2>{item.data.title}</h2>
            {item.data.date && <p class="collection-meta">{new Date(item.data.date).getFullYear()}</p>}
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

